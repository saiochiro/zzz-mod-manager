{
  "name": "zzz-mod-manager",
  "version": "2.14.7",
  "description": "ProxyLaunch: an all-in-one mod launcher for Zenless Zone Zero",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "start": "node ./node_modules/electron/cli.js .",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node ./node_modules/vite/bin/vite.js --port 5173",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.electron.json && node ./node_modules/vite/bin/vite.js build",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "seed": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-sandbox.ts"
  },
  "build": {
    "appId": "com.fairyos.zzzmodmanager",
    "productName": "ProxyLaunch",
    "executableName": "ZZZ Mod Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon/icon.png",
      "assets/icon/icon.ico",
      "package.json",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/linux/**"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "win": {
      "icon": "assets/icon/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProxyLaunch",
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "artifactName": "ProxyLaunch-Setup-${version}.${ext}",
      "include": "installer/installer.nsh"
    },
    "portable": {
      "artifactName": "ProxyLaunch-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saiochiro",
        "repo": "zzz-mod-manager",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.475.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "electron-builder": "^25.1.8"
  },
  "author": "ProxyLaunch",
  "repository": {
    "type": "git",
    "url": "https://github.com/saiochiro/zzz-mod-manager.git"
  }
}
